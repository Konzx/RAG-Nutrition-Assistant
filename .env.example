SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
# Enable: Inference > Make calls to Inference Providers
HF_TOKEN=YOUR_HUGGING_FACE_INFERENCE_TOKEN
# Model and provider are fixed in ingest_new.py; no endpoint URL is required.
# Answer generation uses Groq directly: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Browser-safe key for web/config.js (never use the service-role key here).
SUPABASE_PUBLISHABLE_KEY=
# Alternatively set SUPABASE_ANON_KEY to a legacy anon key.
